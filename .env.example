# ------------------------------------------------------------------
# Project 117 — environment configuration (copy to .env and edit)
# All backend settings use the P117_ prefix.
# ------------------------------------------------------------------

# --- Service ------------------------------------------------------
P117_ENVIRONMENT=development
P117_API_HOST=127.0.0.1
P117_API_PORT=8000
P117_LOG_LEVEL=INFO

# --- Persistence --------------------------------------------------
# SQLite is the Phase-1 default (zero infrastructure).
# Postgres example: postgresql+psycopg://p117:p117@localhost:5432/p117
P117_DATABASE_URL=sqlite:///./data/project117.db

# --- Document storage ---------------------------------------------
P117_UPLOADS_DIR=./data/uploads
P117_MAX_UPLOAD_BYTES=209715200   # 200 MB
# P117_ALLOWED_EXTENSIONS=.pdf,.docx,.txt,.md,.html,.png,.jpg,.jpeg

# --- Local model endpoints (Phase 2 — model gateway) ----------------
# One OpenAI-compatible endpoint serves chat + embeddings. Ollama's /v1
# (default) and vLLM both speak this protocol. NEVER point this at a cloud
# API for confidential work.
P117_LLM_BACKEND=openai_compatible
P117_LLM_BASE_URL=http://localhost:11434/v1
P117_LLM_API_KEY=
P117_LLM_TIMEOUT_SECONDS=120
P117_LLM_AVAILABILITY_TTL=60
P117_OPEN_SANDBOX_BASE_URL=http://localhost:8080

# --- Document ingestion (Phase 3 — localGPT adapter) ----------------
# LanceDB directory/table for vector + full-text indexes. Chunk rows carry
# document_id/page/heading/chunk_index metadata for citations.
P117_LANCEDB_DIR=./data/lancedb
P117_LANCEDB_TABLE=p117_chunks
P117_CHUNK_SIZE_TOKENS=1500
P117_CHUNK_OVERLAP_SENTENCES=1
# Extensions eligible for indexing (upload allows a superset: images etc.)
P117_INGESTIBLE_EXTENSIONS=.pdf,.docx,.txt,.md,.html,.htm

# --- Hybrid retrieval (Phase 4 — localGPT adapter) -------------------
# Reranking re-scores the fused candidate list with the reranker model.
# OFF by default: every reranker backend we vendor resolves to a Hugging Face
# download, which an air-gapped install must never attempt. Enable it only
# after `uv sync --extra rerank` AND setting P117_RERANKER_MODEL to weights
# that are already present on this machine.
P117_RETRIEVAL_RERANK_ENABLED=false
P117_RETRIEVAL_RERANK_CANDIDATES=30
# Evidence chunks attached to a document-grounded chat turn (use_rag).
P117_CHAT_EVIDENCE_TOP_K=5
P117_CHAT_DEFAULT_USE_RAG=false

# --- Model roles (Phase 2 — model gateway) ------------------------
# FAIL-CLOSED: every role is unconfigured by default. Nothing is assumed and
# nothing is downloaded. Asking for an unconfigured role returns a clear
# configuration error (503 model_unavailable) naming the variable to set — it
# never silently picks a model. Point these at models you have actually
# pulled locally; check with `ollama list` or GET /api/models. Never
# hard-code model names in code; always route through the model gateway.
#
# An Ollama tag (name:tag, e.g. nomic-embed-text:latest) runs fully offline.
# A Hugging Face repo id (org/name) DOWNLOADS WEIGHTS on first use, so any
# value containing "/" is REJECTED AT STARTUP unless you deliberately set
# P117_ALLOW_REMOTE_MODEL_REPOS=true below.
P117_REASONING_MODEL=
P117_VISION_MODEL=
P117_EMBEDDING_MODEL=nomic-embed-text:latest
P117_RERANKER_MODEL=
P117_CODING_MODEL=
P117_DOMAIN_MODEL=

# --- Reference configuration: Apple M4, 16 GB unified memory --------------
# A complete, verified set for a 16 GB machine. Every id is an Ollama tag, so
# each runs fully offline once pulled; sizes are on-disk weights, so budget
# roughly 1-2 GB more for the KV cache and the resident embedding server.
#
#   ollama pull llama3:latest              # 4.7 GB  reasoning
#   ollama pull deepseek-coder:6.7b        # 3.8 GB  coding
#   ollama pull mistral:latest             # 4.4 GB  domain
#   ollama pull nomic-embed-text:latest    # 274 MB  embedding
#
# P117_REASONING_MODEL=llama3:latest
# P117_CODING_MODEL=deepseek-coder:6.7b
# P117_DOMAIN_MODEL=mistral:latest
# P117_EMBEDDING_MODEL=nomic-embed-text:latest
#
# Deliberately left unset on this machine:
#   P117_VISION_MODEL    no vision model is pulled; set one only if you need
#                        on-device image/document understanding.
#   P117_RERANKER_MODEL  needs BOTH `uv sync --extra rerank` (torch alone is
#                        ~2 GB) AND weights already present locally. Enabling
#                        it without both is a deliberate startup error.
#
# Larger models were considered and rejected for 16 GB, recorded here so the
# trade-off is explicit rather than accidental: a 14B instruct model at Q4
# (~9 GB) leaves too little headroom once the OS, the embedding server and the
# KV cache are resident, and it swaps under sustained load. Smaller models
# answer faster and leave the machine usable, which matters more for an
# operator console than raw parameter count. Check what you actually have with
# `ollama list` or `GET /api/models`; a role set to an uninstalled tag fails
# loudly at request time rather than silently picking something else.

# Leave false on any air-gapped or confidential deployment. Setting it true
# permits org/name model ids, which fetch weights from the public internet.
P117_ALLOW_REMOTE_MODEL_REPOS=false

# --- Security ------------------------------------------------------
# Phase 1 binds to 127.0.0.1 and performs no authentication.
# Auth/RBAC arrives in Phase 12; do not expose this service to a network
# until then.
#
# Zero external egress, ENFORCED (not just declared) in the HTTP transport:
# every outbound request is checked against this policy before it leaves.
# localhost / 127.0.0.1 / ::1 are always reachable so local Ollama, vLLM and
# OpenSandbox work. Note that 0.0.0.0 is a bind address, not a destination —
# use 127.0.0.1 in P117_LLM_BASE_URL.
P117_EGRESS_DEFAULT_DENY=true
# Exact hostnames (comma-separated, no wildcards) for internal services you
# genuinely need to reach — a plant historian, a DMS, an internal registry.
# Every entry here is a hole in the sovereignty guarantee; keep the list
# short and justify each one.
P117_EGRESS_ALLOWED_HOSTS=

# --- Sandbox (Phase 9) --------------------------------------------
# Overrides for the built-in image map; leave blank to use the defaults
# (python:3.11-slim, project117/sandbox-documents:1.0).
P117_SANDBOX_IMAGE=
P117_SANDBOX_DOCUMENTS_IMAGE=
# Pin by digest once you have built/pulled a known-good image. Recommended
# for anything beyond a laptop trial.
P117_SANDBOX_IMAGE_DIGEST=
P117_SANDBOX_DOCUMENTS_IMAGE_DIGEST=
# Shared secret for the OpenSandbox daemon. Required unless the sandbox port
# is provably unreachable from anywhere but this machine.
P117_SANDBOX_API_KEY=
P117_SANDBOX_REQUIRE_API_KEY=true
P117_SANDBOX_CPU_MILLICORES=500
P117_SANDBOX_MEMORY_MIB=512
P117_SANDBOX_TIMEOUT_SECONDS=120
P117_SANDBOX_LIFETIME_SECONDS=600
P117_SANDBOX_MAX_OUTPUT_BYTES=256000
P117_SANDBOX_MAX_ARTIFACT_BYTES=26214400
# Leave false. See sandbox/policy.py: enabling this without an API key
# refuses to start.
P117_SANDBOX_ALLOW_NETWORK=false

# --- Artifacts (Phase 10) ------------------------------------------
P117_ARTIFACTS_DIR=./data/artifacts

# --- Approvals (Phase 6 policy) ------------------------------------
# Comma-separated tool names that always require approval, regardless of
# their declared risk level.
P117_APPROVAL_ALWAYS_REQUIRE=
# Leave both false. Setting either true removes a human checkpoint before
# code execution or an external-risk action; only do this for a fully
# unattended, already-trusted pipeline.
P117_APPROVAL_AUTO_EXECUTE=false
P117_APPROVAL_AUTO_EXTERNAL=false

# --- Auth (Phase 12) -------------------------------------------------
# Off by default for a single-user on-premise install: an unauthenticated
# request is treated as 'operator' (never 'admin' — see security/rbac.py).
# Set true for any deployment reachable from more than one workstation, and
# set P117_AUTH_API_KEY — an empty key with auth required refuses everything.
P117_AUTH_REQUIRED=false
P117_AUTH_API_KEY=

# --- Observability ------------------------------------------------
# JSON logs are always written; set to false for human-readable console.
P117_JSON_LOGS=false

# ------------------------------------------------------------------
# Read directly from the process environment
# ------------------------------------------------------------------
# These are NOT fields on the settings object; the middleware and services
# read them straight from os.environ. They nevertheless belong in .env:
# backend/config.py calls load_dotenv(".env", override=False) at import, so
# every variable in this file reaches the process environment and an exported
# variable still wins over the file. (Before that call existed, setting any of
# them here was silently ignored.)
#
# P117_SIMULATION_DB=data/simulation.db
# P117_SIM_RETRIEVAL=auto
# P117_FILE_ROOTS=
# P117_WORKSPACE_DIR=
# P117_DEMO_DIR=
# P117_DEMO_WRITEBACK=

# --- HTTP audit trail ---------------------------------------------
# One audit row per request, alongside the domain events. This is why an
# unfiltered GET /api/audit shows http.get/http.post rows as well as
# document.uploaded and friends. Set false to keep only domain events.
P117_AUDIT_HTTP=true

# --- Rate limiting -------------------------------------------------
# Requests/minute per caller. 0 disables the limiter (the single-workstation
# default). Raise this before exposing the console to several users.
P117_RATE_LIMIT_PER_MINUTE=0
P117_RATE_LIMIT_BURST=

# --- Browser access (CORS) -----------------------------------------
# The console is served on 3017. These origins are the only browsers allowed
# to call this API from script; a deployment on another host/port must be
# added here or the console's simulation calls fail as if the backend were
# down. Comma-separated.
P117_CORS_ORIGINS=http://127.0.0.1:3017,http://localhost:3017,http://127.0.0.1:3000,http://localhost:3000

# --- Workflow engine (Phase 15) -------------------------------------
# YAML definitions loaded once at startup, relative to the repository root.
# Missing is fine (empty registry); malformed files are skipped with a warning.
P117_WORKFLOWS_DIR=workflows/definitions

# --- Simulation (Phase 14) -----------------------------------------
P117_SIMULATION_ENABLED=true
P117_SIMULATION_TICK_S=1.0

# --- Tool execution policy -----------------------------------------
# Ceiling on what any plan may invoke without a human in the loop:
# read < write < execute < external.
P117_TOOL_MAX_RISK=execute
# Comma-separated name allow/deny lists. A non-empty allowlist restricts the
# registry to exactly those tools.
P117_TOOL_ALLOWLIST=
P117_TOOL_DENYLIST=
P117_TOOL_MAX_CALLS_PER_PLAN=32
# Evidence chunks a single plan step may pull into its context.
P117_MAX_CHUNKS_PER_STEP=24
