# --- Orchestrator -----------------------------------------------------------
# WebSocket endpoint of the Project 117 orchestrator. Left unset, the app runs
# in MOCK MODE and says so loudly rather than pretending a job ran.
# NOTE: the FastAPI backend in this repo does not currently expose a WebSocket
# endpoint; it streams simulation events over SSE at
# /api/simulation/plants/{id}/stream. Point this at a WS bridge if you run one.
# Example: ws://127.0.0.1:8000/ws/simulation
VITE_ORCHESTRATOR_WS_URL=

# --- Data source ------------------------------------------------------------
# json    (default) read the plant JSON exported by generate_seed.py
# backend          GET {VITE_API_BASE}/plants/{id}, same shape, served from SQLite
VITE_DATA_SOURCE=json

# Base URL used only when VITE_DATA_SOURCE=backend
VITE_API_BASE=http://127.0.0.1:8000
