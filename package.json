{
  "name": "project-117",
  "version": "0.1.0",
  "private": true,
  "description": "Project 117 monorepo: apps/web is a Next.js 14 App Router frontend (industrial simulation console); backend/ is the FastAPI service (simulation engine, agents, RAG, sandbox, audit).",
  "packageManager": "pnpm@9.15.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "pnpm --filter web dev",
    "build": "pnpm --filter web build",
    "start": "pnpm --filter web start",
    "lint": "pnpm --filter web lint",
    "typecheck": "pnpm --filter web typecheck",
    "validate:plants": "python3 scripts/validate_plant_data.py",
    "test:simulation": "python3 tests/simulation/test_verification_regression.py",
    "test:redteam": "python3 tests/simulation/redteam_harness.py"
  }
}
