# ============================================================================
# Project 117 — Field Operations (Android)
#
# The mobile app is a standalone Gradle build, so it carries its own ignore
# rules rather than pushing Android-specific patterns into the repository root.
# ============================================================================

# --- Local machine configuration -------------------------------------------
# `local.properties` carries the absolute path to THIS machine's Android SDK.
# It is generated by Android Studio / the command line tools and is different
# on every developer's box, so it must never be committed.
local.properties
sdk.dir

# --- Gradle ----------------------------------------------------------------
.gradle/
build/
*/build/
gradle-app.setting
.gradletasknamecache

# --- Kotlin incremental-compilation cache ----------------------------------
# Written by the Kotlin daemon; contains session and error logs, not sources.
.kotlin/

# --- Build output -----------------------------------------------------------
# APKs and bundles are build artifacts. A debug APK is producible from source
# with `./gradlew assembleDebug` and does not belong in version control.
*.apk
*.aab
*.ap_
*.dex
release/
output.json

# --- Signing material -------------------------------------------------------
# Never commit a keystore or its credentials.
*.jks
*.keystore
keystore.properties

# --- IDE --------------------------------------------------------------------
.idea/
*.iml
captures/
.externalNativeBuild/
.cxx/

# --- OS ---------------------------------------------------------------------
.DS_Store
Thumbs.db
