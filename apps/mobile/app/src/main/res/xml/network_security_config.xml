<?xml version="1.0" encoding="utf-8"?>
<!--
    Main network security policy.

    Cleartext is denied by default so a release build can only ever talk to an
    HTTPS backend (PRODUCTION). The only exceptions are development loopback
    hosts: 10.0.2.2 is the host machine as seen from the Android emulator, and
    localhost / 127.0.0.1 cover adb-reverse and on-device port forwarding.

    A private LAN address (192.168.x.x, 10.x.x.x, ...) cannot be expressed here —
    the platform has no wildcard for private ranges — so reaching a developer's
    own LAN backend is enabled by the debug-only override in
    src/debug/res/xml/network_security_config.xml. Release builds never see that
    file and therefore refuse arbitrary cleartext.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />

    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
    </domain-config>
</network-security-config>
