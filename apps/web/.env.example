# Project 117 — Next.js console environment (apps/web)
#
# Copy to apps/web/.env.local (Next.js loads it automatically; `.env` works
# too). All three variables are `NEXT_PUBLIC_*`, so they are inlined into the
# browser bundle at build time — never put a secret in this file.
#
# Defaults are also set in apps/web/next.config.mjs, which forwards each value
# into the client bundle. The variable names below are the exact names the code
# reads; there are no others.

# --- Backend origin ---------------------------------------------------------
# Read by src/lib/api.ts, src/lib/sim/adapter.ts and src/lib/uploads.ts.
# The console calls `${NEXT_PUBLIC_API_BASE}/api/...` and
# `${NEXT_PUBLIC_API_BASE}/api/simulation/...`.
# Default: http://127.0.0.1:8000
NEXT_PUBLIC_API_BASE=http://127.0.0.1:8000

# --- Data mode ---------------------------------------------------------------
# Read by src/lib/sim/adapter.ts and src/lib/websocket.ts.
#   live (default) — every read/write goes to the FastAPI backend. If the
#                    backend is unreachable the console shows a hard
#                    "Backend unavailable" error; it never substitutes data.
#   mock           — the in-browser deterministic engine, for offline UI work.
#                    Must be selected explicitly; nothing falls back into it.
NEXT_PUBLIC_DATA_MODE=live

# --- Job websocket -----------------------------------------------------------
# Read by src/lib/websocket.ts for the live job/agent event socket.
# Default: ws://127.0.0.1:8000/api/jobs/ws
NEXT_PUBLIC_WS_URL=ws://127.0.0.1:8000/api/jobs/ws
